
class User{
	
	protected String userId;
	protected String name;
	protected String email;
	protected String phoneno;
	
	
	User(String userId,String name,String email,String phoneno)
	{
		this.userId = userId;
		this.name = name;
		this.email = email;
		this.phoneno = phoneno;
	}
	
	public void displayInfo()
	{
		System.out.println("User Information...");
		System.out.println("\n User Id : "+userId);
		System.out.println("\n Name : "+name);
		System.out.println("\n Email : "+email);
		System.out.println("\n Phone Number "+phoneno);
		
	}
	
	public void borrowBook(String bookTitle)
	{
		System.out.println("Name : "+name+" is borrowing "+bookTitle);
	}
	
	public int getMaxBook()
	{
		return 1;
	}
	
	public String getName() {
		return name;
		
	}
	
	public String userId()
	{
		return userId;
	}
	
	public String email()
	{
		return email;
	}
}

class Student extends User
{
	private String semester;
	private String enrollmentno;
	private int bookBorrowed;
	
	Student(String userId,String name,String email,String phoneno,String semester,String enrollmentno)
	{
		super(userId,name,email,phoneno);
		this.semester = semester;
		this.enrollmentno = enrollmentno;
		this.bookBorrowed = 0;
	}
	
	@Override
	public void borrowBook(String bookTitle)
	{
		if(bookBorrowed >= getMaxBook())
		{
			System.out.println("X"+name+"has reached limit "+getMaxBook()+"books");
			return;
		}
		bookBorrowed++;
		System.out.println("STUDENT BORROWED");
		System.out.println("Student : "+name+" Semester : "+semester);
		System.out.println("Book : "+bookTitle);
		System.out.println("Current Book "+bookBorrowed+"/"+getMaxBook());
		
	}
	
	@Override
	public int getMaxBook()
	{
		return 3;
	}
	
	public void showSemester()
	{
		System.out.println("Semester : "+semester);
	}
	
	public void showEnrollmentno()
	{
		System.out.println("Enrollment Number : "+enrollmentno);
	}
	
	public int getBookBorrowed()
	{
		return bookBorrowed;
	}
}

